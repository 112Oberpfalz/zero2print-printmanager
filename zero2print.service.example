[Unit]
Description=Zero2Print PrintManager
After=network.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/zero2print-printmanager
ExecStart=/home/pi/zero2print-printmanager/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target